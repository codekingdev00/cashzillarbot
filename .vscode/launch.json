{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run paper bot",
      "type": "debugpy",
      "request": "launch",
      "module": "bot",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\.venv\Scripts\python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "Backtest (exchange data)",
      "type": "debugpy",
      "request": "launch",
      "module": "bot",
      "args": ["backtest", "--source", "exchange"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\.venv\Scripts\python.exe",
      "console": "integratedTerminal"
    }
  ]
}
